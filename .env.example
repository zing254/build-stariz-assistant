# STARIZ AI Assistant - Environment Configuration
# Copy this file to .env and update values as needed

# Backend Configuration
PYTHONUNBUFFERED=1
LOG_LEVEL=info

# AI Model Configuration
STARIZ_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Frontend Configuration
VITE_PYTHON_BACKEND_URL=http://localhost:8000

# Security (recommended outside localhost)
# STARIZ_API_TOKEN=replace-with-a-long-random-token
# Restrict origins in production; never use * with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional modules. Disable heavy features if the machine lacks their models.
ENABLE_VOICE=true
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_AGENT=false
ENABLE_FILE_INDEXING=false

# Redis (optional - enables persistent rate limiting)
# REDIS_URL=redis://localhost:6379

# CSP (Content Security Policy)
# CSP_ENABLED=true

# Voice Configuration
VOSK_MODEL_PATH=./backend/models/vosk
PIPER_MODEL_PATH=./backend/models/piper
