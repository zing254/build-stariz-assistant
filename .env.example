# STARIZ AI Assistant - Environment Configuration
# Copy this file to .env and update values as needed

# Backend Configuration
PYTHONUNBUFFERED=1
LOG_LEVEL=info

# AI Model Configuration
STARIZ_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Frontend Configuration
VITE_PYTHON_BACKEND_URL=http://localhost:8000

# Security (optional - set to enable API token auth)
# STARIZ_API_TOKEN=your-secret-token-here

# Voice Configuration
VOSK_MODEL_PATH=./backend/models/vosk
PIPER_MODEL_PATH=./backend/models/piper
