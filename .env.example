# STARIZ AI Assistant - Environment Configuration
# Copy this file to .env and update values as needed

# Backend Configuration
PYTHONUNBUFFERED=1
LOG_LEVEL=info

# AI Model Configuration
STARIZ_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434

# Frontend Configuration
VITE_PYTHON_BACKEND_URL=http://localhost:8000

# Security (optional - set to enable API token auth)
# STARIZ_API_TOKEN=your-secret-token-here
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Redis (optional - enables persistent rate limiting)
# REDIS_URL=redis://localhost:6379

# CSP (Content Security Policy)
# CSP_ENABLED=true

# Voice Configuration
VOSK_MODEL_PATH=./backend/models/vosk
PIPER_MODEL_PATH=./backend/models/piper
